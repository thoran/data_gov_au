#!/usr/bin/env ruby
# data_gov_au

# 20261103
# 0.2.0

require 'switches.rb'
require 'yaml'

require_relative '../lib/data_gov_au'
require_relative '../lib/DataGovAu/ABR'

BYTES_PER_KILOBYTE = 1024
BYTES_PER_MEGABYTE = 1_048_576
CONFIG_PATH = '~/.config/data_gov_au/config.yaml'
DATASETS = ['abr']
SECONDS_PER_MINUTE = 60
SETTINGS = [:api_url, :data_directory, :user_agent]

def usage
  puts "data_gov_au - datasets published on data.gov.au: fetch, store and query."
  puts
  puts "Usage: data_gov_au DATASET [options]"
  puts
  puts "Datasets:"
  puts "  abr                       The Australian Business Register's weekly ABN bulk extract"
  puts
  puts "Options:"
  puts "  -d, --data-directory DIR  Where every dataset is kept (default: $XDG_DATA_HOME/data_gov_au)"
  puts "  -n, --dry-run             Report what would be retrieved without retrieving it"
  puts "  -p, --parse               Parse the newest release held, retrieving nothing"
  puts "  -q, --quiet               Report nothing but errors"
  puts "  -h, --help                Show this help"
end

def switches
  @switches ||= Switches.new do |s|
    s.optional(:d, :data_directory){'Where every dataset is kept (default: $XDG_DATA_HOME/data_gov_au)'}
    s.boolean(:n, :dry_run){'Report what would be retrieved without retrieving it'}
    s.boolean(:p, :parse){'Parse the newest release held, retrieving nothing'}
    s.boolean(:q, :quiet){'Report nothing but errors'}
    s.perform(:h, :help?) do
      usage
      exit
    end
  end
end

# What is left once the switches are read, OptionParser taking them out of ARGV wherever they stood.
def dataset
  @dataset ||= ARGV.first
end

def default_data_directory
  data_home = ENV['XDG_DATA_HOME'].to_s
  File.join(data_home.empty? ? File.join('~', '.local', 'share') : data_home, 'data_gov_au')
end

def config_path
  @config_path ||= File.expand_path(CONFIG_PATH)
end

def stored_settings
  @stored_settings ||= File.exist?(config_path) ? read_settings : {}
end

# A file which is not a mapping stops the run rather than leaving it on the defaults, which would hide a typo in the one place the machine's own settings live.
def read_settings
  settings = YAML.safe_load_file(config_path) || {}
  report_failure("#{config_path} does not hold a mapping") unless settings.is_a?(Hash)
  settings.transform_keys(&:to_sym)
end

def switched_settings
  {data_directory: switches.data_directory}
end

# A setting left blank or a switch left off is nil, and leaves what lies beneath it standing.
def settings
  @settings ||= {data_directory: default_data_directory}.merge(stored_settings.compact, switched_settings.compact).slice(*SETTINGS)
end

def config
  @config ||= DataGovAu::ABR::Config.new(**settings)
end

def fetch
  @fetch ||= DataGovAu::ABR::Fetch.new(config)
end

# The newest release on disk, which is read from the directory names and so costs nothing: parsing goes nowhere near the network.
def held_release
  @held_release ||= (
    date = DataGovAu::ABR::Release.dates_held(config).first
    raise DataGovAu::ABR::NothingToParse, "no release is held in #{config.releases_directory}" unless date
    DataGovAu::ABR::Release.new(config, date)
  )
end

def report(message)
  puts message unless switches.quiet?
end

def reported_size(size)
  return 'size unknown' if size.nil?
  return "#{(size.to_f / BYTES_PER_MEGABYTE).round} MB" if size >= BYTES_PER_MEGABYTE
  "#{(size.to_f / BYTES_PER_KILOBYTE).round} kB"
end

# Rounded before it is divided, so that no duration reads as 60 seconds.
def reported_duration(seconds)
  whole_seconds = seconds.round
  return "#{whole_seconds} s" if whole_seconds < SECONDS_PER_MINUTE
  "#{whole_seconds / SECONDS_PER_MINUTE} m #{whole_seconds % SECONDS_PER_MINUTE} s"
end

def describe(resource)
  "  #{resource.filename} (#{reported_size(resource.size)})"
end

def report_release
  report("release:   #{fetch.release}")
  report("catalogue: #{fetch.modified_on.strftime('%Y%m%d')}")
  report("licence:   #{fetch.dataset.licence}")
  report("held:      #{fetch.resources.length - fetch.release.missing.length} of #{fetch.resources.length} files")
  fetch.release.missing.each{|resource| report(describe(resource))}
end

def retrieve_release
  report(fetch.release.complete? ? 'nothing to retrieve' : "retrieving into #{fetch.release.directory}")
  fetch.perform{|resource| report("  #{resource.filename}")}
end

def fetch_release
  report_release
  retrieve_release unless switches.dry_run?
end

# Each file is set against the count it carries itself, so that a file which gave up fewer records than it promised, or which reports an error, is reported rather than passing as a smaller week.
def parse_release
  report("release:   #{held_release}")
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  records = 0
  not_whole = []
  DataGovAu::ABR::Extract.new(held_release).each_file do |member, parser|
    parser.each_record{}
    records += parser.records_parsed
    report(file_report(member, parser))
    not_whole << member unless parser.whole?
  end
  report("total:     #{records} records in #{reported_duration(Process.clock_gettime(Process::CLOCK_MONOTONIC) - started)}")
  report_not_whole(not_whole) unless not_whole.empty?
end

def file_report(member, parser)
  line = "  #{member}  #{parser.records_parsed} of #{parser.record_count}"
  return line if parser.error_free?
  "#{line}  error: #{parser.error || 'not given'}"
end

def report_not_whole(members)
  report_failure("fewer records than promised, or an error reported, in #{members.join(', ')}")
end

def report_failure(message)
  $stderr.puts "data_gov_au: #{message}"
  exit 1
end

def check_dataset
  return if DATASETS.include?(dataset)
  report_failure("#{dataset ? "#{dataset} is not a dataset" : 'no dataset named'}; one of #{DATASETS.join(', ')}")
end

def main
  $stdout.sync = true
  switches
  check_dataset
  switches.parse? ? parse_release : fetch_release
rescue DataGovAu::Error => error
  report_failure(error.message)
end

main
